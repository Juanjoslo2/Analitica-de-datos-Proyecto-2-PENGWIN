!01_data/splits.json

# Zona personal de pruebas (no se sube)
000_pruebas_y_experimentos_locales/

# Markdown: solo README, IA_USAGE y los reportes llegan al repositorio
*.md
!README.md
!IA_USAGE.md
!reports/**/*.md

# Entorno y cachés
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
pytest-cache-files-*/
*.egg-info/
build/
dist/

# Datos derivados y pesos (los .pth se publican en GitHub Releases)
data_processed/
*.pth
!checkpoints/.gitkeep
runs/
cloudflared*

# Caché del EDA (se regenera con scripts/run_eda_extract.py); las tablas consolidadas sí se versionan
reports/eda/cache/
