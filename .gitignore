# Datos crudos PENGWIN (~32 GB, se descargan de Zenodo; nunca a git)
01_data/PENGWIN_CT_train_images_part1/
01_data/PENGWIN_CT_train_images_part2/
01_data/PENGWIN_CT_train_labels/
!01_data/.gitkeep
!01_data/splits.json

# Zona personal de pruebas (no se sube)
000_pruebas_y_experimentos_locales/

# Markdown: solo README, IA_USAGE y los reportes llegan al repositorio
*.md
!README.md
!IA_USAGE.md
!reports/**/*.md

# Entorno y cachés
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
pytest-cache-files-*/
*.egg-info/
build/
dist/

# Datos derivados y pesos (los .pth se publican en GitHub Releases)
data_processed/
*.pth
!checkpoints/.gitkeep
runs/
cloudflared*

# Caché del EDA (se regenera con scripts/run_eda_extract.py); las tablas consolidadas sí se versionan
reports/eda/cache/

# Ajuste de la semana 10: los crudos (uno por experimento y fold) se quedan fuera de git.
# Se versiona lo consolidado (scripts/consolidar_ajuste.py -> reports/tuning/ajuste_*),
# los resúmenes .md y EXPERIMENTOS.csv. Los cambios de cada config quedan en ajuste_corridas.
reports/tuning/pp*.csv
reports/tuning/pp*.json
reports/tuning/borde_*.json
reports/tuning/lambdas/
reports/tuning/fase2/F2B*/
reports/train/cv_*
reports/overfit/overfit_f2b*
configs/tuning/*.yaml
reports/tuning/ESTADO.md
reports/tuning/PROGRESO.md
